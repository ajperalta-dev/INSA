# ============================================================
# ALPHA Digital Transformation — Environment Variables
# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit real keys.
# ============================================================

# ── EmailJS (Booking Confirmation Emails) ──────────────────
# Setup: https://www.emailjs.com/docs/tutorial/overview/
#
# 1. Create a free account at https://emailjs.com
# 2. Add Email Service → Select Gmail → Connect alpha.digital.ia@gmail.com
# 3. Create Email Template with these variables:
#      {{to_name}}, {{to_email}}, {{service}}, {{date}}, {{time}},
#      {{company}}, {{gcal_link}}, {{notes}}, {{reply_to}}
# 4. Paste your IDs below:

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
